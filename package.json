{
  "name": "nyumbanihub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pos": "vite --config vite.config.pos.ts",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "build": "npm run sitemap && tsc -b && vite build",
    "build:pos": "tsc -b --build tsconfig.pos.json && vite build --config vite.config.pos.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:pos": "vite preview --config vite.config.pos.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@supabase/supabase-js": "^2.101.0",
    "axios": "^1.18.1",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "postcss": "^8.5.15",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.6.6",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.10.1",
    "remixicon": "^4.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/i18next-browser-languagedetector": "^2.0.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-i18next": "^7.8.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.1.0"
  }
}
